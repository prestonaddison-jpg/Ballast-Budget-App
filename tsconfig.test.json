{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Tests straddle two runtimes: global-setup.ts runs in Node, everything
    // else runs inside workerd. Both type sets are loaded here so a single
    // typecheck covers the whole test tree.
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types",
      "node"
    ],
    "noEmit": true
  },
  "include": ["test/**/*.ts", "vitest.config.ts", "web/src/**/*.ts"]
}
