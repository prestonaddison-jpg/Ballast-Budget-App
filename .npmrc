# npm 10's peer-dependency resolver crashes ("Cannot read properties of null
# (reading 'edgesOut')") when resolving @cloudflare/vitest-pool-workers against
# vitest 4: vitest declares OPTIONAL peers (@vitest/browser-*, @vitest/ui) that
# npm resolves to their v5 line, which peer-depends on vitest 5, and arborist
# faults on the resulting cycle instead of reporting a clean ERESOLVE.
#
# The conflict is spurious — none of those optional packages are installed —
# but it is not fixable with `overrides` (verified). Until npm ships a fix,
# peer resolution is relaxed repo-wide so `npm install` works on a fresh clone.
legacy-peer-deps=true
